<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 游戏通过 Assembly.LoadFrom 加载 mods/ 顶层 DLL，程序集名必须与文件名一致 -->
    <AssemblyName>PGvZOnlineMod</AssemblyName>
    <RootNamespace>PGvZOnlineMod</RootNamespace>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- 验证宿主与中继服务端是独立工程；mod 在仓库根上，默认 glob 会把它们也扫进来，必须显式排除 -->
    <Compile Remove="VerifyHost\**" />
    <None Remove="VerifyHost\**" />
    <Compile Remove="RelayServer\**" />
    <None Remove="RelayServer\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用游戏自带程序集（Private=false：不复制到输出目录，运行时游戏已加载同名程序集） -->
    <Reference Include="Lawn">
      <HintPath>$(PgvzRef)Lawn.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="IronPython">
      <HintPath>$(PgvzRef)IronPython.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Scripting">
      <HintPath>$(PgvzRef)Microsoft.Scripting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(PgvzRef)MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(PgvzRef)MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PgvzRef)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 传输层：Lawn.dll 本体的依赖（Lawn.deps.json: Lidgren.Network.Core2 1.0.0），随游戏进程已加载 -->
    <Reference Include="Lidgren.Network">
      <HintPath>$(PgvzRef)Lidgren.Network.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
