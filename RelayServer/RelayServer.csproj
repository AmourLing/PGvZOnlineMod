<Project Sdk="Microsoft.NET.Sdk">

  <!-- 跨互联网中继服务端：纯 UDP 转发，不解析模组协议，也不引用任何游戏程序集。
       所以它能独立编译、独立部署到 Linux，不参与 mod 的编译门。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>PGvZRelay</AssemblyName>
    <RootNamespace>PGvZRelay</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 本工程不引用任何游戏程序集，跳过仓库根那个"缺 Lawn.dll 就报错"的守卫（Linux 上也没有那目录） -->
    <PgvzRefGuard>false</PgvzRefGuard>
  </PropertyGroup>

  <ItemGroup>
    <!-- 控制协议与模组共用同一份定义（服务端不再自己写一套，两端才不会写串） -->
    <Compile Include="..\src\Protocol\RelayProtocol.cs" Link="linked\RelayProtocol.cs" />
  </ItemGroup>

</Project>
